{
  "name": "thisisme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "access:issue": "node --experimental-strip-types scripts/issue-access-code.mjs",
    "private-profile:set": "node --experimental-strip-types scripts/set-private-profile.mjs",
    "testimonial:moderate": "node --experimental-strip-types scripts/moderate-testimonial.mjs",
    "analytics:cleanup": "node --experimental-strip-types scripts/cleanup-analytics.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:repository": "node scripts/check-repository-safety.mjs",
    "check": "pnpm lint && pnpm build && pnpm check:repository && pnpm check:migrations && git -c safe.directory=* diff --check"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "swagger-ui-react": "^5.32.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "sass": "^1.102.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "wrangler": "^4.123.0"
  }
}
